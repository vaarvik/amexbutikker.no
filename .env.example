# Local Postgres (docker compose)
POSTGRES_PORT=5432
DATABASE_URL=postgres://amexbutikker:amexbutikker@localhost:5432/amexbutikker

# API
STORAGE=postgres
# At least 32 characters. Generate with: openssl rand -base64 48
DEVICE_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info

