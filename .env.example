# Local Postgres (docker compose)
POSTGRES_PORT=5432
DATABASE_URL=postgres://amexbutikker:amexbutikker@localhost:5432/amexbutikker

# API
STORAGE=postgres
# At least 32 characters. Generate with: openssl rand -base64 48
DEVICE_TOKEN_SECRET=change-me-to-a-random-string-of-at-least-32-chars
# 0.0.0.0 so phones on the same Wi-Fi can reach the API in dev. Use 127.0.0.1 to keep it local.
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
# true behind a hosting proxy (Render, Fly), so rate limits see the client's address.
# TRUST_PROXY=false
# Serve the web app's static export at / (the container sets this to its built copy).
# WEB_ROOT=apps/mobile/dist
# Browser origins allowed to call the API, comma-separated, exact (no wildcard).
# 8081 is the Expo dev server's web page; `pnpm tunnel` adds its own tunnel URL.
CORS_ORIGINS=http://localhost:8081

# Imports (pnpm run import <source>)
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# When overpass-api.de answers 502/504, a mirror usually works:
# OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# OVERPASS_AREA_ID=3600406091   # Oslo kommune
# IMPORT_CACHE_DIR=data/cache
# IMPORT_CACHE_MAX_AGE_HOURS=168
# CURATED_CLAIMS_PATH=data/curated-claims.yaml
# STATEMENT_PATH=data/statements/statement.txt   # gitignored; never commit a statement

# Device attestation (Phase 16, docs/hosting.md). Unattested devices' answers count less.
# Local development and the simulator cannot attest, so trust every device here. Never in production.
TRUST_UNATTESTED_DEVICES=true
# <Team ID>.<bundle id> of each iOS build allowed to attest, comma-separated; empty turns App Attest off
# APP_ATTEST_APP_IDS=ABCDE12345.no.amexbutikker.app
# APP_ATTEST_DEVELOPMENT=false
# Cloudflare Turnstile secret and the hostnames the widget runs on; unset turns Turnstile off
# TURNSTILE_SECRET_KEY=
# TURNSTILE_HOSTNAMES=amex.johann.no
# Private deployment with passkey sign-in (docs/hosting.md); unset leaves the API open
# PASSKEY_ORIGIN=https://amex.johann.no
# PASSKEY_INVITE_CODE=
