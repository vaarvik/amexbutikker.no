# Copy to infra/home/.env (gitignored) and fill in. Never commit the real file.

# Database password. Generate with: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=
# At least 32 characters; changing it signs every device out. Generate with: openssl rand -base64 48
DEVICE_TOKEN_SECRET=
# From Cloudflare: Zero Trust -> Networks -> Tunnels -> your tunnel -> install connector (the token part).
TUNNEL_TOKEN=
# Exact origins of a hosted web app, comma-separated. Empty while there is none.
CORS_ORIGINS=
